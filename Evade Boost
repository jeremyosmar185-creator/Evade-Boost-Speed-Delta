local value2 = 36
Text1.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        local NewSpeed = tonumber(Text1.Text)
        
        if NewSpeed and NewSpeed > 0 then
            value2 = NewSpeed
        else
            value2 = 36
        end  
    end
end)
local value = 75
 
Text2.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        local NewForceSpeed = tonumber(Text2.Text)
        
        if NewForceSpeed and NewForceSpeed > 0 then
            value = NewForceSpeed
        else
            value = 75
        end  
    end
end)
 
for _, n in ipairs(HumanoidRootPart:GetChildren()) do
    if n and n:IsA("LinearVelocity") and n.Name ~= "Force" then
        n:Destroy()
    end
end

local canjump = 10
local isInAir = false

local function updateMovement()
    local state = Humanoid:GetState()
    Humanoid.WalkSpeed = value2
    
    local Attachment = HumanoidRootPart:FindFirstChild("AttachmentForce") or Instance.new("Attachment")
    Attachment.Name = "AttachmentForce"
    Attachment.Parent = HumanoidRootPart
    
    local LinearVelocity = HumanoidRootPart:FindFirstChild("Force") or Instance.new("LinearVelocity")
    LinearVelocity.Attachment0 = Attachment
    LinearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    LinearVelocity.Name = "Force"
    LinearVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
    LinearVelocity.PrimaryTangentAxis = Vector3.new(1, 0, 0)
    LinearVelocity.SecondaryTangentAxis = Vector3.new(0, 0, 1)
    LinearVelocity.Parent = HumanoidRootPart
    
    if state ~= Enum.HumanoidStateType.Freefall then
        -- En el suelo: desactivar LinearVelocity
        LinearVelocity.MaxForce = 0
        isInAir = false
        return
    end
    
    -- En el aire: activar control horizontal
    LinearVelocity.MaxForce = 80000 -- ajusta la fuerza si quieres
    
    if not isInAir then
        isInAir = true
    end
    
    -- Velocidad horizontal basada en la dirección de movimiento
    local moveDir = Humanoid.MoveDirection
    speed = value
    
    LinearVelocity.PlaneVelocity = Vector2.new(moveDir.X * speed, moveDir.Z * speed)
end

local function conectar()
    if con and con.Connected then
        con:Disconnect()
    end
    con = RunService.RenderStepped:Connect(function()
        updateMovement()
        JumpButton.Visible = true
        TouchControlFrame.Visible = true
        
        for _, sky in ipairs(Lighting:GetChildren()) do
            if sky and sky:IsA("Sky") then
                sky:Destroy()
            end
        end
        
        for _, part in ipairs(Workspace:GetDescendants()) do
            if part and part:IsA("BasePart") then
                part.Material = Enum.Material.SmoothPlastic
            end
        end
        
        for _, n2 in ipairs(HumanoidRootPart:GetChildren()) do
            if n2 and n2:IsA("LinearVelocity") and n2.Name ~= "Force" then
                n2:Destroy()
            end
        end
        
        canjump = math.clamp(canjump - 1, 0, 10)
        
        -- Mobile fixer
        if canjump == 10 then
            Humanoid.JumpPower = 40
        end
    end)
end
conectar()

-- Limpiar al morir
Humanoid.Died:Connect(function()
    if con and con.Connected then
        con:Disconnect()
    end
    LinearVelocity:Destroy()
    Attachment:Destroy()
end)
